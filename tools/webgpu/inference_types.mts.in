// Type helpers for the generated operation schema.
export type OperationName = keyof typeof INFERENCE_SCHEMA.operations;
export type ArgumentKind = 'buffer' | 'state' | 'weight' | 'weights' | 'vector' | 'layer_buffer' | 'options' | 'integer' | 'number' | 'boolean' | 'precision';
export interface ArgumentSpec {readonly name:string; readonly kind:ArgumentKind; readonly access:string; readonly precision:string; readonly optional:boolean}
export type Expression = null | boolean | number | string | Expression[] | {[key:string]:Expression};
type Ref<K extends string> = {$:K;name:string;stride?:number;view?:'batch'|'always'|'head'};
type Variable = Ref<'var'>;
type Choice<T> = {$:'choose';condition:'batch'|'head_all';yes:T;no:T};
interface NumericChoice {$:'choose';condition:'batch'|'head_all';yes:Numeric;no:Numeric}
type Numeric = number | Variable | {$:'product';values:Numeric[]} | NumericChoice;
type Value<K> = K extends 'integer'|'number' ? Numeric : K extends 'boolean' ? boolean|Variable : K extends 'precision' ? 'f16'|'f32'|Variable : K extends 'buffer' ? Ref<'buffer'>|Choice<Ref<'buffer'>> : K extends 'state' ? Ref<'state'> : K extends 'weight' ? Ref<'matrix'|'resource'> : K extends 'weights' ? Ref<'resource'> : K extends 'vector' ? Ref<'vector'|'buffer'> : K extends 'layer_buffer' ? Ref<'layer_buffer'> : {[key:string]:Expression};
type Named<A extends readonly {name:string;kind:string;optional:boolean}[]> = {[P in A[number] as P['optional'] extends false ? P['name'] : never]:Value<P['kind']>} & {[P in A[number] as P['optional'] extends true ? P['name'] : never]?:Value<P['kind']>};
export type OperationArguments = {[K in OperationName]:Named<typeof INFERENCE_SCHEMA.operations[K]>};
